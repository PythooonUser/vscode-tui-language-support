{
  "name": "vscode-tui-language-support",
  "displayName": "vscode-tui-language-support",
  "description": "tui Language Support for VSCode.",
  "version": "0.7.0",
  "license": "MIT",
  "publisher": "pythooonuser",
  "author": {
    "name": "Felix Siebeneicker"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pythooonuser/vscode-tui-language-support"
  },
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Linters"
  ],
  "contributes": {
    "languages": [
      {
        "id": "tui",
        "aliases": [
          "Tui",
          "tui"
        ],
        "extensions": [
          ".tui"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tui",
        "scopeName": "source.tui",
        "path": "./syntaxes/tui.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "tui",
      "type": "object",
      "properties": {
        "vscode-tui-language-support.null-literal": {
          "type": "string",
          "enum": [
            "null",
            "nil",
            "any"
          ],
          "default": "any",
          "description": "The literal to use for nullable values"
        },
        "vscode-tui-language-support.table-literal": {
          "type": "string",
          "enum": [
            "brace",
            "bracket",
            "any"
          ],
          "default": "any",
          "description": "The delimiters to use for table literals"
        }
      }
    }
  },
  "main": "dist/src/client/client",
  "scripts": {
    "compile": "tsc -b",
    "test": "mocha --node-option=import=tsx **/*.test.ts",
    "utils:lexer": "npx tsx ./tools/lexer-utils.ts",
    "utils:parser": "npx tsx ./tools/parser-utils.ts",
    "utils:formatter": "npx tsx ./tools/formatter-utils.ts",
    "utils:linter": "npx tsx ./tools/linter-utils.ts"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.99.1",
    "@vscode/vsce": "^3.9.2",
    "mocha": "^11.2.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^10.1.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  }
}
