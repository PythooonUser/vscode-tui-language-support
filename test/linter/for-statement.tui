# for-statement-1
for () {} # TODO: Should throw "expected expression"

# for-statement-2
for (foo in bar) {} # TODO: Only throw "bar" as undefined

# for-statement-3
for (index, foo in bar) {} # TODO: Only throw "bar" as undefined

# for-statement-4
for (i = 0, i > 10, i++) {} # TODO: Don't mark "i" as undefined

# for-statement-5
