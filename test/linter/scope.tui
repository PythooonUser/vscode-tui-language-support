# scope-1
foo,

# scope-2
foo = {},
foo.bar,

# scope-3
foo = { bar: 42 },
foo.bar,

# scope-4
x = 42,
foo = {
    .x = 10,
}

# scope-5
foo.bar.baz,

# scope-6
{ .x = 10 },
print(x)

# scope-7
{ x = 10 },
print(x)

# scope-8
{ .x = 10, x }, x

# scope-9
test = { .global = 10, print("", global) }

# scope-10
x = 10, { x = 20, .x = 5 }

# scope-11
table = {
    subTable = {
        .global = 10
        print(global)
    }
}

# scope-12
a = 0
if (a == 0) {
    a = 1
}

# scope-13
foo = {
    bar = {
        .global = 10
        print(global)
    }
}

# scope-14
value = 1
table = {
    number = 10
    .value = 2
    .global = 40
    print(global)
}
print(global)
